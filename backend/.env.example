PORT=5000
# Region: "lucknow" (default) or a custom bbox "south,west,north,east"
# NEXORA_REGION=lucknow
# NEXORA_BBOX=26.82,80.90,26.90,81.00
# NEXORA_REGION_NAME=My region
# NEXORA_GRAPH=auto            # auto | osm | sample
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_USER_AGENT=NEXORA/0.1 (your-email@example.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=NEXORA/0.1 (your-email@example.com)

# Phase 6: saved routes, route history and analytics are stored per "control session" (anonymous workspace).
# NEXORA_STORE=file            # file (default, persistent) | memory (lost on restart)
# NEXORA_DATA_DIR=./data/workspaces
